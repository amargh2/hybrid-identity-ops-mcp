# Okta Integration (Optional for Okta sync triggers & verification)
OKTA_ORG_URL=https://your-org.okta.com
OKTA_API_TOKEN=your_okta_api_token_here

# Microsoft Entra Connect Server (Hostname of AD Connect server if triggering remotely)
